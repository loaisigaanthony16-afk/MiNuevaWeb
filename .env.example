# =====================================================================
# Variables de entorno de Vibe 505
#
# Copiá este archivo como `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.
# =====================================================================

# --- NOWPayments ---
# Clave de API. Solo servidor: nunca llega al navegador.
NOWPAYMENTS_API_KEY=

# Secreto del IPN, para validar la firma de los avisos del webhook.
# Sin esto el webhook rechaza todo: cualquiera podría marcar pedidos como pagados.
NOWPAYMENTS_IPN_SECRET=

# --- Sitio ---
# Base pública, usada para las URLs de retorno y del IPN.
NEXT_PUBLIC_SITE_URL=https://www.vibe505.com

# Orígenes permitidos para /api/create-nowpayments-invoice, separados por coma.
# El host de la propia petición siempre se permite.
ALLOWED_ORIGINS=https://vibe505.com,https://www.vibe505.com
