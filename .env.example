# =====================================================================
# Variables de entorno de Vibe 505
#
# Copiá este archivo como `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.
# =====================================================================

# --- NOWPayments ---
# Clave de API. Solo servidor: nunca llega al navegador.
NOWPAYMENTS_API_KEY=

# Secreto del IPN, para validar la firma de los avisos del webhook.
# Sin esto el webhook rechaza todo: cualquiera podría marcar pedidos como pagados.
NOWPAYMENTS_IPN_SECRET=

# --- Supabase (pedidos) ---
# Clave de servicio (Project Settings > API > service_role / secret key).
# SOLO SERVIDOR: con ella el webhook guarda el estado de cada pedido y la
# página confirma el pago sola. Sin ella el cobro funciona igual, pero la
# confirmación depende del retorno de la pasarela.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: por defecto se usa el proyecto vibe505.
SUPABASE_URL=https://idefyablegqrnvwtvboo.supabase.co

# --- Sitio ---
# Base pública, usada para las URLs de retorno y del IPN.
NEXT_PUBLIC_SITE_URL=https://www.vibe505.com
# Alias aceptado; si existe, tiene prioridad.
# NEXT_PUBLIC_APP_URL=https://www.vibe505.com

# Orígenes permitidos para /api/checkout/init, separados por coma.
# El host de la propia petición siempre se permite.
ALLOWED_ORIGINS=https://vibe505.com,https://www.vibe505.com

# Pago directo con tarjeta en la pasarela.
# Dejalo en false hasta que NOWPayments habilite tarjeta en tu cuenta: si lo
# mandás sin habilitar, NOWPayments rechaza la factura y no se cobra nada.
NOWPAYMENTS_ENABLE_CARD=false
