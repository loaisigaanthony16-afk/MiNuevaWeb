# =====================================================================
# Variables de entorno de Vibe 505
#
# Copiá este archivo como `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.
# =====================================================================

# Clave PUBLICABLE de Stripe. Es pública por diseño: viaja al navegador.
# En Next.js las variables del cliente deben llevar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_xxx

# Clave SECRETA de Stripe. Solo servidor. Nunca la compartas ni la subas.
STRIPE_SECRET_KEY=sk_live_xxx

# Opcional: orígenes extra permitidos para /api/create-payment-intent,
# separados por coma. El host de la propia petición siempre se permite.
ALLOWED_ORIGINS=https://vibe505.com,https://www.vibe505.com
