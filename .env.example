# =====================================================================
# Variables de entorno de Vibe 505
#
# Copiá este archivo como `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.
# =====================================================================

# --- Stripe ---
# Clave secreta. SOLO SERVIDOR: nunca llega al navegador.
STRIPE_SECRET_KEY=
# Clave publicable: habilita el formulario de pago dentro del modal.
# Sin ella el cobro usa la página alojada de Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secreto de firma del webhook (Developers > Webhooks > endpoint
# https://www.vibe505.com/api/webhooks/stripe).
STRIPE_WEBHOOK_SECRET=

# --- Supabase (pedidos) ---
# Clave de servicio (Project Settings > API > service_role / secret key).
# SOLO SERVIDOR: con ella el webhook guarda el estado de cada pedido y la
# página confirma el pago desde la base. Sin ella la página verifica cada
# pago directamente con Stripe.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: por defecto se usa el proyecto vibe505.
SUPABASE_URL=https://idefyablegqrnvwtvboo.supabase.co

# --- Chat del pedido ---
# Clave del panel de pedidos (vibe505.com/admin). Elegí una larga y única.
ADMIN_KEY=
# Clave para cifrar los mensajes en la base. Si falta, se deriva de la
# clave de servicio de Supabase. Si la cambiás, los mensajes anteriores
# dejan de poder leerse.
CHAT_SECRET=

# --- Avisos por correo al comercio (Resend, resend.com) ---
# Con esta clave se manda un correo al quedar pagado un pedido y cuando un
# cliente escribe en el chat. Sin ella no se envía nada (todo lo demás
# funciona igual).
RESEND_API_KEY=
# Destinatario(s), separados por coma. Por defecto: loaisigaanthony16@gmail.com
NOTIFY_EMAIL=
# Remitente. Sin dominio verificado en Resend usá el de prueba:
# NOTIFY_FROM=Vibe 505 <onboarding@resend.dev>

# --- Avisos push (Web Push) ---
# Par de claves VAPID. Se generan una vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# La pública llega al navegador; la privada SOLO SERVIDOR.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto asociado a las claves (mailto:).
VAPID_SUBJECT=mailto:loaisigaanthony16@gmail.com

# --- Cron de vigilancia del webhook ---
# Vercel manda este valor en Authorization al llamar /api/cron/check-pending.
CRON_SECRET=

# --- Sitio ---
# Base pública, usada para las URLs de retorno y del IPN.
NEXT_PUBLIC_SITE_URL=https://www.vibe505.com
# Alias aceptado; si existe, tiene prioridad.
# NEXT_PUBLIC_APP_URL=https://www.vibe505.com

# Orígenes permitidos para /api/checkout/init, separados por coma.
# El host de la propia petición siempre se permite.
ALLOWED_ORIGINS=https://vibe505.com,https://www.vibe505.com


# --- Publicación automática en Instagram y Facebook ---
# La usa el cron /api/cron/social-post, que saca una pieza por día de la
# tabla social_queue de Supabase y la sube a las dos redes.
#
# Lo que hay que tener del lado de Meta, por orden:
#  1. La cuenta de Instagram tiene que ser Profesional (empresa o creador)
#     y estar ligada a la página de Facebook. Tenerlas en Business Suite
#     no alcanza: eso no da acceso a la API.
#  2. Crear una app en developers.facebook.com y agregarle el producto
#     "Instagram". Con la app en modo desarrollo alcanza mientras seas
#     administrador de la página y de la cuenta; no hace falta App Review.
#  3. Permisos: instagram_basic, instagram_content_publish, pages_show_list,
#     pages_read_engagement y pages_manage_posts.
#  4. El token: usar un USUARIO DE SISTEMA de Business Manager. El token de
#     página normal vence a los 60 días y dejaría el cron muerto sin avisar.
#
# Instagram solo deja publicar 25 piezas por día; una diaria va sobrada.
META_ACCESS_TOKEN=
# ID numérico de la cuenta de Instagram (no el @usuario).
META_IG_USER_ID=
# ID numérico de la página de Facebook.
META_PAGE_ID=
# Opcional; por defecto v21.0.
# META_GRAPH_VERSION=v21.0
